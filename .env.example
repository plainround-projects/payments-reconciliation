# Copied to .env by `make up` the first time. Every value is for a database that lives on this machine only.
POSTGRES_HOST=localhost
POSTGRES_PORT=54612
POSTGRES_DB=reconciliation
POSTGRES_USER=reconciliation
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_MAX_SIZE=10

API_HOST=127.0.0.1
API_PORT=8462
SHUTDOWN_GRACE_SECONDS=10
LOG_LEVEL=INFO

# Where the provider's daily files arrive (settlement_YYYY-MM-DD.csv). The simulation writes here too.
SETTLEMENT_DIR=var/settlement
CURRENCY=USD
# The provider closes each day's batch at this UTC time; captures after it settle the next day.
SETTLEMENT_CUTOFF_UTC=23:00
# A timing difference that has waited this many days becomes a problem for a person.
MAX_CARRY_DAYS=2
# The stub provider's fee in basis points (290 = 2.9%, which makes 1.23 on 42.50).
PROVIDER_FEE_BPS=290
